{
    "name": "samikeijonen/ketunkoti",
    "description": "Ketun koti site: development tooling (PHP linting).",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint:php": "phpcs -q plugins/ketunkoti-features plugins/ketunkoti-ai plugins/ketunkoti-blocks themes/ketunkoti",
        "fix:php": "phpcbf -q plugins/ketunkoti-features plugins/ketunkoti-ai plugins/ketunkoti-blocks themes/ketunkoti"
    }
}
