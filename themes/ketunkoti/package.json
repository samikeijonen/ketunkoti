{
	"name": "ketunkoti-theme",
	"version": "1.0.0",
	"description": "Theme for Ketun koti",
	"author": "Sami Keijonen",
	"license": "GPL-2.0-or-later",
	"private": true,
	"keywords": [
		"WordPress",
		"Theme"
	],
	"homepage": "https://ketunkoti.fi/",
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.34.0",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"cssnano": "^7.1.2"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
  "scripts": {
    "build": "postcss style.css --use cssnano -o style.min.css --no-map",
    "watch": "postcss style.css --use cssnano -o style.min.css --no-map --watch"
  }
}
