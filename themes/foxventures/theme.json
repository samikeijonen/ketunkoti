		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|contrast"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-2",
						"text": "var:preset|color|contrast"
					}
				},
				"typography": {
					"fontWeight": "600"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|tirra",
					"fontWeight": "700"
				}
			},
