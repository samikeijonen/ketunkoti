<?xml version="1.0"?>
<ruleset name="Ketun koti">
    <description>Coding standard for the Ketun koti plugins and theme.</description>

    <!-- WordPress core coding standards, with short array syntax allowed. -->
    <rule ref="WordPress">
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Build output and dependencies are not linted. -->
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- Each plugin and the theme use their own text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ketunkoti-features"/>
                <element value="ketunkoti-ai"/>
                <element value="ketunkoti-blocks"/>
                <element value="ketunkoti"/>
            </property>
        </properties>
    </rule>
</ruleset>
